# Exemplo. Copie para wrangler.toml e troque os valores marcados. Nenhum ID aqui é real.
name = "ponto-eletronico"
main = "servidor/worker.js"
compatibility_date = "2025-09-01"

# Static Assets: a pasta site/ vai como arquivos; o Worker só acorda para /api/*.
[assets]
directory = "./site"
binding = "ASSETS"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "ponto-eletronico"
database_id = "TROQUE-PELO-ID-QUE-O-WRANGLER-IMPRIMIR"

# O SEGREDO não vai neste arquivo: `npx wrangler secret put SEGREDO` (veja o README).
