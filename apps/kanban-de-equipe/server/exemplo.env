MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kanban
# Obrigatório. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000

# Chave estática usada pelo servidor MCP e pela Action do ChatGPT (equivale a admin).
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=

# Sincronização de Issues do GitHub (opcional). Token de acesso pessoal com escopo
# "repo" (classic) ou Issues read/write (fine-grained).
GITHUB_TOKEN=
GITHUB_SYNC_MINUTES=5
