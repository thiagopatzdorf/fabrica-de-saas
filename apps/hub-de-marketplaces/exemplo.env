# Copie para .env (que NÃO vai para o Git). Nenhum valor abaixo é real.

# --- Banco ---------------------------------------------------------------
# Sem DATABASE_URL o app usa PGlite (Postgres embarcado, em memória: os dados
# somem ao reiniciar). Com ela, usa Postgres de verdade; rode `npm run db:migrate`.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/hub
# Opcional: grava o PGlite em disco para os dados sobreviverem ao reinício.
# PGLITE_DATA_DIR=.pglite

# --- Autenticação (Better Auth, e-mail e senha) ---------------------------
# Obrigatória em produção, >= 32 caracteres. Gere com: openssl rand -hex 32
# BETTER_AUTH_SECRET=
# URL pública do app (padrão: http://localhost:8080)
# BETTER_AUTH_URL=https://hub.exemplo.com
# Origens extras aceitas em POST, separadas por vírgula
# TRUSTED_ORIGINS=https://hub.exemplo.com
# "true" fecha o cadastro aberto (crie os usuários antes e feche)
# HUB_DISABLE_SIGNUP=false

# --- Demonstração ---------------------------------------------------------
# "false" cria cada organização vazia, sem a Oficina Norte fictícia
# HUB_SEED_DEMO=true
# Usuário de demonstração opcional, criado no primeiro acesso a /api/auth.
# Só para avaliação local; não defina em produção.
# HUB_DEMO_EMAIL=demo@example.com
# HUB_DEMO_PASSWORD=
