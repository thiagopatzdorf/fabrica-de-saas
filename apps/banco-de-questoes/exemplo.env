# Banco de dados (PostgreSQL). Em provedores serverless com pooler,
# DATABASE_URL é a conexão via pooler e DIRECT_URL a conexão direta usada
# pelo Prisma. Se o seu Postgres não usa pooler, repita o mesmo valor.
DATABASE_URL="postgres://usuario:senha@localhost:5432/banco"
DIRECT_URL="postgres://usuario:senha@localhost:5432/banco"

# Auth.js. Gere um valor com: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Credentials > OAuth Client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Link mágico por e-mail (SMTP)
EMAIL_SERVER_HOST="smtp.exemplo.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Banco de Questões <login@seudominio.com>"
