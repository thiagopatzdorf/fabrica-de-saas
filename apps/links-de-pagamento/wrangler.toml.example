# Copie para wrangler.toml e ajuste. Nenhum valor abaixo é real.
name = "links-de-pagamento"
main = "worker.js"
compatibility_date = "2025-01-01"

# Páginas estáticas (site/). O Worker acorda só para o que não é arquivo.
[assets]
directory = "./site"
binding = "ASSETS"
run_worker_first = true

# Armazenamento: links, registro de pagamentos e a chave do Stripe (cifrada).
# Crie com: npx wrangler kv namespace create ESTADO  e cole o id aqui.
[[kv_namespaces]]
binding = "ESTADO"
id = "COLE_AQUI_O_ID_DO_KV"

# Domínio próprio (opcional). Troque pelo seu.
# [[routes]]
# pattern = "pagar.exemplo.com.br"
# custom_domain = true

# Segredos NÃO vão aqui. Use: npx wrangler secret put PAGAR_TOKEN  /  SESSAO_SEGREDO
