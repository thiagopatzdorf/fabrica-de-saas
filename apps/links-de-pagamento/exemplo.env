# Variáveis e segredos do Worker (em produção: `wrangler secret put <NOME>`; nunca commite valores reais).
# Aqui só como documentação; o Worker não lê arquivo .env.

# Token da API (Authorization: Bearer ...). Mínimo 20 caracteres. Gere com: openssl rand -hex 32
PAGAR_TOKEN=

# Segredo que cifra a chave do Stripe no KV e assina o convite de /configurar. Gere com: openssl rand -hex 32
SESSAO_SEGREDO=

# Só para `node servir-local.mjs` (opcional):
# PORT=8788
